# Copy to .env.local and fill in what you have. Every value is optional —
# the app falls back to seeded sample data when nothing is configured, so it
# runs offline out of the box.
#
# Keep list values on a single line. A quoted multi-line value parses in Node
# but arrives in Vercel's env UI with the quote attached, which turns the first
# entry into a bad board ID — and a bad board ID fails silently, see below.


# ── Access ──────────────────────────────────────────────────────────────────
# The password for the dashboard. Leave empty for local-only use: with no value
# the gate is off, so `npm run dev` doesn't ask you to log in.
#
# Setting this is REQUIRED before the app is reachable from the internet. The
# store holds your search history, your notes on each posting, and a resume with
# your contact details in it. `npm run build` refuses to produce a production
# build without it — see scripts/check-env.mjs.
APP_PASSWORD=

# Optional. Lets you sign out of every device without changing the password:
# rotate this value and all existing sessions stop working. Any long random
# string; generate one with `node -e "console.log(crypto.randomUUID())"`.
SESSION_SALT=

# Shared secret for callers that can't hold a session cookie — scripts, cron.
# The dashboard's own Run button authenticates with your login instead, so this
# is only needed for scripts/daily-run.mjs against a deployed instance. The
# GitHub Actions workflow does NOT need it: it runs the pipeline in-process
# rather than over HTTP.
CRON_SECRET=


# ── Sources ─────────────────────────────────────────────────────────────────
# Adzuna — the best single source for India + US. Free key at
# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Company-owned ATS boards. Comma-separated board tokens, taken from the public
# board URL. This is the highest-signal source available — postings appear here
# the day the company publishes them.
#
# These are LEFT COMMENTED OUT on purpose. src/lib/sources.ts already ships 113
# verified boards as its defaults, and that list is what the nightly GitHub
# Actions run uses — it passes no board variables at all. Setting one here
# *replaces* the default rather than adding to it, so an uncommented line with
# three tokens in it silently cuts the run from 113 boards to 3. Set them only
# to deliberately narrow or redirect the search.
#
# Verify any token you add: `npm run check:boards`. Companies migrate between
# ATS vendors, and a stale token fails silently as "0 postings" rather than as
# an error. Netflix used to be in the Lever list here and had already moved to
# Eightfold, so that board returned nothing for weeks; `ramp` sat in the Lever
# list while its board was on Ashby.
#   boards.greenhouse.io/<token>
# GREENHOUSE_BOARDS=stripe,databricks,figma
#   jobs.lever.co/<token>
# LEVER_BOARDS=sonarsource,matillion
#   jobs.ashbyhq.com/<token>
# ASHBY_BOARDS=astronomer,snowflake,confluent

# How many board fetches run at once. 113 boards through an unbounded fan-out
# holds every response body in memory simultaneously and invites the rate
# limiting that turns a live board into a silent zero.
FETCH_CONCURRENCY=10

# Jobicy — remote-first, and the only keyword source that accepts free-text
# tags, so it can be pointed at your actual skills. Leave unset: the tags are
# derived from your resume's signature skills by src/lib/resumeSearch.ts.
# JOBICY_TAGS=airflow,aws,typescript

# The Muse — the only source configured here that reaches non-remote India
# roles. CASE-SENSITIVE and unforgiving about it: `software engineering` returns
# HTTP 200 with zero results, `Software Engineering` returns 40,519. This is the
# one list that is NOT lowercased before use, precisely because of that.
MUSE_CATEGORIES=Software Engineering,Data and Analytics
# 20 postings per page, per category. The API rejects pages above 99.
MUSE_PAGES=6
MUSE_LEVEL=Senior Level

# Search terms for the keyword sources (Remotive, Adzuna). Leave unset — they are
# derived from your resume by src/lib/resumeSearch.ts, so editing PROFILE.skills
# or the bullet bank changes what gets searched. See the Settings page for the
# terms a run will actually use.
#
# Set this only to pin the list by hand. Each term costs one request per keyword
# source, so a long list is the quickest way to trip Adzuna's free-tier limit.
# SEARCH_QUERIES=principal software engineer,staff engineer airflow


# ── Misc ────────────────────────────────────────────────────────────────────
# Where scripts/daily-run.mjs points. Only needed if not localhost:3000.
APP_URL=http://localhost:3000
