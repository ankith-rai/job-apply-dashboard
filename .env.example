# Copy to .env.local and fill in what you have. Every source is optional —
# the app falls back to seeded sample data when nothing is configured, so it
# runs offline out of the box.


# ── Access ──────────────────────────────────────────────────────────────────
# The password for the dashboard. Leave empty for local-only use: with no value
# the gate is off, so `npm run dev` doesn't ask you to log in.
#
# Setting this is REQUIRED before the app is reachable from the internet. The
# store holds your search history, your notes on each posting, and a resume with
# your contact details in it. `npm run build` refuses to produce a production
# build without it — see scripts/check-env.mjs.
APP_PASSWORD=

# Optional. Lets you sign out of every device without changing the password:
# rotate this value and all existing sessions stop working. Any long random
# string; generate one with `node -e "console.log(crypto.randomUUID())"`.
SESSION_SALT=

# Shared secret for callers that can't hold a session cookie — scripts, cron.
# The dashboard's own Run button authenticates with your login instead, so this
# is only needed for scripts/daily-run.mjs against a deployed instance. The
# GitHub Actions workflow does NOT need it: it runs the pipeline in-process
# rather than over HTTP.
CRON_SECRET=


# ── Sources ─────────────────────────────────────────────────────────────────
# Adzuna — the best single source for India + US. Free key at
# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Company-owned ATS boards. Comma-separated board tokens, taken from the public
# board URL. This is the highest-signal source available — postings appear here
# the day the company publishes them.
#
# Verify a token before adding it: `npm run check:boards`. Companies migrate
# between ATS vendors, and a stale token fails silently as "0 postings" rather
# than as an error. Netflix used to be in the Lever list here and had already
# moved to Eightfold, so that board returned nothing for weeks.
#   boards.greenhouse.io/<token>
GREENHOUSE_BOARDS=stripe,databricks,figma
#   jobs.lever.co/<token>
LEVER_BOARDS=plaid
#   jobs.ashbyhq.com/<token>
ASHBY_BOARDS=astronomer


# ── Misc ────────────────────────────────────────────────────────────────────
# Where scripts/daily-run.mjs points. Only needed if not localhost:3000.
APP_URL=http://localhost:3000
