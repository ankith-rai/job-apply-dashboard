# Copy to .env.local and fill in what you have. Every source is optional —
# the app falls back to seeded sample data when nothing is configured, so it
# runs offline out of the box.

# Adzuna — the best single source for India + US. Free key at
# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Company-owned ATS boards. Comma-separated board tokens, taken from the
# public board URL: boards.greenhouse.io/<token> or jobs.lever.co/<token>.
# This is the highest-signal source available — postings appear here the day
# the company publishes them.
GREENHOUSE_BOARDS=stripe,databricks,figma
LEVER_BOARDS=netflix,ramp

# Shared secret for POST /api/run. Leave empty for local-only use; set it
# before exposing the app to the internet, since /api/run is a write endpoint
# that makes outbound calls.
CRON_SECRET=

# Where scripts/daily-run.mjs points. Only needed if not localhost:3000.
APP_URL=http://localhost:3000
