{
  "name": "job-apply-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:env": "node scripts/check-env.mjs",
    "typecheck": "tsc --noEmit",
    "run:daily": "node scripts/daily-run.mjs",
    "run:inline": "node --no-warnings --import ./scripts/register.mjs scripts/run-inline.mts",
    "check:boards": "node --no-warnings --import ./scripts/register.mjs scripts/check-boards.mts",
    "test": "node --no-warnings --import ./scripts/register.mjs tests/logic.test.mjs && node --no-warnings --import ./scripts/register.mjs tests/store.test.mjs && node --no-warnings --import ./scripts/register.mjs tests/auth.test.mjs",
    "check:resume": "node --no-warnings --import ./scripts/register.mjs scripts/check-resume.mjs",
    "rescore": "node --no-warnings --import ./scripts/register.mjs scripts/rescore.mjs",
    "prune": "node --no-warnings --import ./scripts/register.mjs scripts/prune.mjs"
  },
  "dependencies": {
    "next": "^14.2.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "5.5.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.32",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7"
  }
}
